<?xml version="1.0"?>
<ruleset name="formpipe">
	<description>Coding standards for the FormPipe WordPress plugin.</description>

	<file>formpipe.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>modules</file>
	<file>rest</file>
	<file>admin</file>
	<file>assets/block/index.js</file>
	<file>assets/block/render.php</file>
	<file>assets/block/block.json</file>

	<exclude-pattern>tests/*</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>assets/admin/index.asset.php</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>

	<!-- WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- Allow short array syntax. -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<!-- We control our own prefix via FORMPIPE_; WP's i18n sniff expects __()/_e() which we use. -->
		<exclude name="WordPress.PHP.YodaConditions"/>
		<!-- Plugin header is in formpipe.php, not the standard Plugin Name header file. -->
		<exclude name="WordPress.NamingConventions.ValidFunctionName"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>
	</rule>

	<!-- PHP cross-version compatibility for declared 8.0 minimum. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.0-"/>

	<config name="text_domain" value="formpipe"/>
	<config name="minimum_supported_wp_version" value="6.5"/>
</ruleset>
